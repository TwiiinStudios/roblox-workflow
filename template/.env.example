# Copy this file to .env (git-ignored) to use the Roblox tools from your own PC. Never commit .env.
# Create the keys: see docs/07-publishing.md in roblox-workflow.

# Open Cloud key for the TEST (and LIVE) experience: publishing (universe-places write) and the cloud
# test (luau-execution-sessions read + write). Used by tools/publish.luau and tools/cloudtest.luau.
ROBLOX_API_KEY=

# Open Cloud key made under the studio's group with Assets read + write: uploading images and models
# owned by the group (tools/import/upload_asset.py).
ROBLOX_ASSETS_KEY=
